{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "sentry": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.sentry.dev/mcp?agent=1"
    },
    "revenuecat": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.revenuecat.ai/mcp",
      "headers": {
        "Authorization": "Bearer {file:.env.revenuecat-key}"
      }
    },
    "dart-mcp-server": {
      "type": "local",
      "enabled": true,
      "command": [
        "dart",
        "mcp-server"
      ],
      "environment": {}
    }
  }
}
